# Generated OCR engine assets (produced by scripts/vendor-ocr.mjs on build).
# The Capacitor android/ project is committed, but its copy of the web assets
# (android/app/src/main/assets/public/) is git-ignored by Capacitor's own android/.gitignore,
# so the engine lives in git only as node_modules + eng.traineddata and is regenerated on build.
public/tesseract/

# Signing material must never be committed.
*.keystore
*.jks
android/keystore.properties

# Build artifacts (release outputs are produced on demand).
*.apk
*.aab
*.apks
